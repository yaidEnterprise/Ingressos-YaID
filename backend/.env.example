# ==============================================
# Credenciais YaID (obter no painel da YaID)
# ==============================================

# Chave de API para autenticar chamadas ativas à YaID
YAID_API_KEY=

# Chave pública Ed25519 para validar assinaturas de webhooks
# Obtida via: GET https://api.yaid.com.br/api/webhook-public-key
YAID_PUBLIC_KEY=

# ==============================================
# Configurações do servidor
# ==============================================
PORT=3001

# URL base do frontend (para CORS e redirecionamentos)
FRONTEND_URL=http://localhost:5173

# URL base da YaID (homologação)
YAID_API_BASE_URL=https://api.yaid.com.br

# URL pública deste backend (necessária para Ngrok — RNF-04)
# Exemplo: https://abc123.ngrok.io
BACKEND_PUBLIC_URL=http://localhost:3001
